{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Tauri Development Debug",
            "cargo": {
                "args": [
                    "build",
                    "--manifest-path=${workspaceFolder}/packages/desktop/src-tauri/Cargo.toml",
                    "--no-default-features"
                ]
            },
            "preLaunchTask": "ui:dev",
            "cwd": "${workspaceFolder}/packages/desktop"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Tauri Production Debug",
            "cargo": {
                "args": [
                    "build",
                    "--release",
                    "--manifest-path=${workspaceFolder}/packages/desktop/src-tauri/Cargo.toml"
                ]
            },
            "preLaunchTask": "ui:build",
            "cwd": "${workspaceFolder}/packages/desktop",
        },
        {
            "type": "node",
            "request": "launch",
            "name": "TUI Debug",
            "runtimeExecutable": "bun",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "autoAttachChildProcesses": true
        }
    ]
}